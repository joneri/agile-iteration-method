        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "blockedFrom": {
          "enum": [
            "in_progress",
            "review",
            "validation",
            "acceptance"
          ]
        },
        "reworkHistory": {
          "type": "array",

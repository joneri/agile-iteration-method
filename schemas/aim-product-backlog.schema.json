              "validationEvidence": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/evidence"
                },
                "minItems": 1,
                "maxItems": 64
              },
              "criterionEvidence": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/criterionEvidence"
                },
                "minItems": 1,
                "maxItems": 16384
              },
              "acceptanceSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "productBindings": {
                "type": "array",
                "minItems": 1,
                "maxItems": 256,
                "items": {
                  "type": "object",
                  "required": [
                    "path",
                    "sha256"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "blockedReason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "\\S"
              },
              "qualityMeasurements": {
                "type": "array",
                "minItems": 0,
                "maxItems": 32,
                "items": {
                  "$ref": "#/$defs/evidence"
                }
              },
              "correctionContextSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "reason",
              "from",
              "at"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 256
        },
        "planEvidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1,
          "maxItems": 64
        },
        "productBindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": [

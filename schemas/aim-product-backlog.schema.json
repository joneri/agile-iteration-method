            "$ref": "#/$defs/evidence"
          },
          "minItems": 1,
          "maxItems": 64
        },
        "criterionEvidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/criterionEvidence"
          },
          "minItems": 1,
          "maxItems": 16384
        },
        "acceptanceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "acceptance": {
          "$ref": "#/$defs/authority"

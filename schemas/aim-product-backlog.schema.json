        "qualityMeasurements": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "qualityPlan": {
          "$ref": "#/$defs/qualityPlan"

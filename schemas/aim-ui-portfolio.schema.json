{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joneri.github.io/agile-iteration-method/schemas/aim-ui-portfolio.schema.json",
  "title": "AIM UI portfolio",
  "description": "Read-only discovery catalog for independently authoritative AIM Epic workspaces beneath one repository .aim boundary.",
  "type": "object",
  "required": ["portfolioVersion", "workspaces"],
  "properties": {
    "portfolioVersion": {"const": "1.0"},
    "workspaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Path relative to the repository .aim directory. Runtime validation confines the resolved path to that directory."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
